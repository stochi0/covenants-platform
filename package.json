{
  "name": "capillia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run server\" \"pnpm run dev:vite\"",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:all": "pnpm run dev",
    "data:diagnose": "node server/diagnose-data.mjs",
    "server": "tsx server/index.ts",
    "data:dry-run": "cd ../scripts && uv run python migrate_excel_to_supabase.py --dry-run",
    "data:apply": "cd ../scripts && uv run python migrate_excel_to_supabase.py --apply"
  },
  "dependencies": {
    "@clerk/react": "^6.7.2",
